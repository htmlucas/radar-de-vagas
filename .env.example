# Banco local (Postgres no Docker)
POSTGRES_DB=vagas
POSTGRES_USER=vagas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5440

# Opcional: token do GitHub (somente leitura de repositórios públicos).
# Sem ele o limite é 60 requisições por hora, o que já basta para uso diário.
GITHUB_TOKEN=

# Adzuna: crie uma chave gratuita em https://developer.adzuna.com/
# Sem essas chaves, o coletor da Adzuna é pulado.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# API do Claude, para gerar currículos adaptados: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Pasta onde ficam os dados brutos (camada bronze)
DATA_DIR=dados
